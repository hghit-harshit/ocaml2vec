(executable
 (name dump_counts)
 (modules dump_counts)
 (libraries ir2vec compiler-libs.optcomp)
 (flags (:standard -w +8 -warn-error +8)))

(rule
 (alias runtest)
 (deps
  phase0_dumps.sh
  %{exe:dump_counts.exe}
  %{exe:../bin/ir2vec_extract.exe}
  (glob_files %{workspace_root}/tests/fixtures/*.ml))
 (action
  (run bash %{dep:phase0_dumps.sh} %{exe:dump_counts.exe}
   %{workspace_root}/tests/fixtures %{exe:../bin/ir2vec_extract.exe})))

