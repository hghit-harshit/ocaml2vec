; Golden snapshots. `dune test` diffs; `dune promote` accepts a change.
; Every fixture is extracted at both levels; the Python tests read these.

(rule
 (action
  (with-stdout-to align.lambda.json.gen
   (run bash %{dep:../../extractor/test/extract_fixture.sh} lambda
    %{exe:../../extractor/bin/ir2vec_extract.exe} %{dep:../fixtures/align.ml}))))

(rule
 (alias runtest)
 (action (diff align.lambda.json align.lambda.json.gen)))

(rule
 (action
  (with-stdout-to align.cmm.json.gen
   (run bash %{dep:../../extractor/test/extract_fixture.sh} cmm
    %{exe:../../extractor/bin/ir2vec_extract.exe} %{dep:../fixtures/align.ml}))))

(rule
 (alias runtest)
 (action (diff align.cmm.json align.cmm.json.gen)))

